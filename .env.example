APP_ENV=development
APPLICATION_BUILD_REFERENCE=
DATABASE_URL=postgresql+psycopg://tenderguard:tenderguard@localhost:5432/tenderguard
OBJECT_STORE_BACKEND=local
LOCAL_OBJECT_STORE_PATH=./var/objects
LOCAL_QUARANTINE_STORE_PATH=./var/quarantine
MAX_UPLOAD_BYTES=524288000
MAX_PARSER_SPOOL_MEMORY_BYTES=8388608
MAX_SCAN_REPORT_BYTES=1048576
MAX_API_REQUEST_BYTES=2097152
OIDC_ISSUER=https://id.example.invalid/realms/tenderguard
OIDC_AUDIENCE=tenderguard-api
OIDC_JWKS_URL=https://id.example.invalid/realms/tenderguard/protocol/openid-connect/certs
OIDC_WEB_CLIENT_ID=tenderguard-operator-ui
OIDC_WEB_SCOPE=openid profile email
OPERATOR_UI_ENABLED=true
# OPERATOR_UI_DIST_PATH=./web/dist
# Development/test only. The manifest must pin a local extraction artifact by SHA-256.
# DIAGNOSTIC_PROJECT_MANIFEST_PATH=./var/diagnostic-projects/alabuga-4527946.json
ALLOW_INSECURE_DEV_AUTH=false
AUDIT_SIGNING_KEY=
AUDIT_SIGNING_KEY_ID=
AUDIT_VERIFICATION_KEYS={}
AUDIT_ANCHOR_PROVIDER_ID=
AUDIT_ANCHOR_PROVIDER_KEY_ID=
AUDIT_ANCHOR_PUBLIC_KEY_B64=
AUDIT_ANCHOR_MAX_AGE_SECONDS=86400
AUDIT_OPERATOR_ORGANIZATION_ID=
REQUIRE_IDEMPOTENCY_KEYS=true
# Production and staging require distributed actor and organisation quotas.
# Values are deliberately not supplied: the methodology/security owner must
# approve them from representative load and abuse evidence.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_IDENTITY_KEY_ID=<approved-secret-version>
# RATE_LIMIT_IDENTITY_KEY=<at-least-32-byte-secret>
# RATE_LIMIT_WINDOW_SECONDS=<approved-positive-integer>
# RATE_LIMIT_ACTOR_READ_REQUESTS=<approved-positive-integer>
# RATE_LIMIT_ORGANIZATION_READ_REQUESTS=<approved-positive-integer>
# RATE_LIMIT_ACTOR_MUTATION_REQUESTS=<approved-positive-integer>
# RATE_LIMIT_ORGANIZATION_MUTATION_REQUESTS=<approved-positive-integer>
# RATE_LIMIT_ACTOR_UPLOAD_REQUESTS=<approved-positive-integer>
# RATE_LIMIT_ORGANIZATION_UPLOAD_REQUESTS=<approved-positive-integer>
EXPORT_SIGNING_KEY_ID=
EXPORT_SIGNING_PRIVATE_KEY_B64=
TRUSTED_HOSTS=["tenderguard.example.internal"]
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=tenderguard
S3_QUARANTINE_BUCKET=tenderguard-quarantine
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REQUIRED_OBJECT_LOCK_MODE=COMPLIANCE
S3_MINIMUM_RETENTION_DAYS=
NORMATIVE_ADAPTER=
NORMATIVE_ADAPTER_QUALIFICATION_ID=
MALWARE_SCANNER_ADAPTER=
MALWARE_SCANNER_QUALIFICATION_ID=
DOCUMENT_PROCESSOR_ADAPTER=
DOCUMENT_PROCESSOR_QUALIFICATION_ID=
DOCUMENT_WORKER_ACTOR_ID=
BOQ_XLSX_ADAPTER=
BOQ_XLSX_ADAPTER_QUALIFICATION_ID=
BOQ_XLSX_WORKER_ACTOR_ID=
FGISCS_ADAPTER=
FGISCS_ADAPTER_QUALIFICATION_ID=
FGISCS_WORKER_ACTOR_ID=
AUTOMATION_REWORK_ADAPTER=
AUTOMATION_REWORK_QUALIFICATION_ID=
AUTOMATION_REWORK_WORKER_ACTOR_ID=
AUTOMATION_JOB_LEASE_SECONDS=300
AUTOMATION_JOB_TIMEOUT_SECONDS=240
AUTOMATION_JOB_MAX_ATTEMPTS=5
AUTOMATION_JOB_RETRY_BASE_SECONDS=30
AUTOMATION_JOB_RETRY_MAX_SECONDS=3600
DOCUMENT_JOB_LEASE_SECONDS=900
DOCUMENT_JOB_TIMEOUT_SECONDS=840
DOCUMENT_JOB_MAX_ATTEMPTS=3
DOCUMENT_JOB_RETRY_BASE_SECONDS=30
DOCUMENT_JOB_RETRY_MAX_SECONDS=900
