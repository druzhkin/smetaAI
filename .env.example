APP_ENV=development
DATABASE_URL=postgresql+psycopg://tenderguard:tenderguard@localhost:5432/tenderguard
OBJECT_STORE_BACKEND=local
LOCAL_OBJECT_STORE_PATH=./var/objects
LOCAL_QUARANTINE_STORE_PATH=./var/quarantine
MAX_UPLOAD_BYTES=524288000
MAX_PARSER_SPOOL_MEMORY_BYTES=8388608
MAX_SCAN_REPORT_BYTES=1048576
OIDC_ISSUER=https://id.example.invalid/realms/tenderguard
OIDC_AUDIENCE=tenderguard-api
OIDC_JWKS_URL=https://id.example.invalid/realms/tenderguard/protocol/openid-connect/certs
ALLOW_INSECURE_DEV_AUTH=false
AUDIT_SIGNING_KEY=
EXPORT_SIGNING_KEY_ID=
EXPORT_SIGNING_PRIVATE_KEY_B64=
TRUSTED_HOSTS=["tenderguard.example.internal"]
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=tenderguard
S3_QUARANTINE_BUCKET=tenderguard-quarantine
S3_ACCESS_KEY=
S3_SECRET_KEY=
MALWARE_SCANNER_ADAPTER=
MALWARE_SCANNER_QUALIFICATION_ID=
DOCUMENT_PROCESSOR_ADAPTER=
DOCUMENT_PROCESSOR_QUALIFICATION_ID=
DOCUMENT_WORKER_ACTOR_ID=
